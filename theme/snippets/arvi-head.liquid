{%- comment -%}
  ARVI design layer: loaded once from layout/theme.liquid, right after base.css.
  Keeps every ARVI-specific global style out of Dawn core files.
{%- endcomment -%}
{%- if settings.arvi_display_font == 'newsreader' -%}
  {{ 'arvi-newsreader-normal-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {% style %}
    @font-face {
      font-family: 'ARVI Newsreader';
      font-style: normal;
      font-weight: 200 600;
      font-display: swap;
      src: url('{{ 'arvi-newsreader-normal-latin.woff2' | asset_url }}') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'ARVI Newsreader';
      font-style: normal;
      font-weight: 200 600;
      font-display: swap;
      src: url('{{ 'arvi-newsreader-normal-latin-ext.woff2' | asset_url }}') format('woff2');
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }
    @font-face {
      font-family: 'ARVI Newsreader';
      font-style: italic;
      font-weight: 200 600;
      font-display: swap;
      src: url('{{ 'arvi-newsreader-italic-latin.woff2' | asset_url }}') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'ARVI Newsreader';
      font-style: italic;
      font-weight: 200 600;
      font-display: swap;
      src: url('{{ 'arvi-newsreader-italic-latin-ext.woff2' | asset_url }}') format('woff2');
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }
    :root {
      --arvi-font-display: 'ARVI Newsreader', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    }
  {% endstyle %}
{%- else -%}
  {% style %}
    :root {
      --arvi-font-display: var(--font-heading-family);
    }
  {% endstyle %}
{%- endif -%}
{% style %}
  :root {
    --arvi-accent: {{ settings.arvi_accent_color | default: '#998A65' }};
    --arvi-accent-text: {{ settings.arvi_accent_text_color | default: '#6E6246' }};
  }
{% endstyle %}
{{ 'arvi-base.css' | asset_url | stylesheet_tag }}
<script src="{{ 'arvi.js' | asset_url }}" defer="defer"></script>
