{{ 'arvi-sections.css' | asset_url | stylesheet_tag }}

<div class="arvi-heritage color-{{ section.settings.color_scheme }} gradient arvi-pad--{{ section.settings.padding }}">
  <div class="page-width arvi-heritage__grid">
    <div class="arvi-heritage__media scroll-trigger animate--fade-in">
      {%- render 'arvi-image',
        image: section.settings.image,
        fallback: section.settings.fallback_image,
        alt: section.settings.image_alt,
        sizes: '(min-width: 990px) 58vw, 100vw',
        class: 'arvi-heritage__img'
      -%}
      {%- if section.settings.caption != blank -%}
        <p class="arvi-micro arvi-heritage__caption">{{ section.settings.caption }}</p>
      {%- endif -%}
    </div>

    <div class="arvi-heritage__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="arvi-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="arvi-display arvi-display--l">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="arvi-body rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <a class="arvi-link" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- assign stats = section.blocks | where: 'type', 'stat' -%}
  {%- if stats.size > 0 -%}
    <div class="page-width">
      <dl class="arvi-stats arvi-stats--{{ stats.size }}">
        {%- for block in stats -%}
          <div class="arvi-stat scroll-trigger animate--slide-in" data-cascade style="--animation-order: {{ forloop.index }};" {{ block.shopify_attributes }}>
            <dt class="arvi-meta">{{ block.settings.label }}</dt>
            <dd class="arvi-display arvi-display--stat">{{ block.settings.value }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'quote' and block.settings.quote != blank -%}
      <figure class="page-width arvi-quote" {{ block.shopify_attributes }}>
        <blockquote class="arvi-display arvi-display--quote">
          {{- block.settings.quote -}}
        </blockquote>
        {%- if block.settings.author != blank -%}
          <figcaption class="arvi-meta">{{ block.settings.author }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "ARVI · Heritage & cellar",
  "tag": "section",
  "class": "section arvi-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our cellar" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Every bottle owned, stored and traced by ARVI" },
    {
      "type": "richtext", "id": "text", "label": "Text",
      "default": "<p>All wines we offer are owned by our company and stored in our temperature- and humidity-controlled cellars. Every single case is checked upon receipt by our professional staff, photographed and registered, which guarantees full traceability.</p>"
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "About ARVI" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_image", "label": "Bundled fallback image", "default": "arvi-cellar" },
    { "type": "text", "id": "image_alt", "label": "Image description (alt text)", "default": "Original wooden wine cases stacked on shelves in the ARVI cellar in Melano" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "The ARVI cellar, Melano" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-2" },
    {
      "type": "select", "id": "padding", "label": "Vertical spacing", "default": "l",
      "options": [{ "value": "s", "label": "Small" }, { "value": "m", "label": "Medium" }, { "value": "l", "label": "Large" }]
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Key figure",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Figure", "default": "30+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Years of experience" }
      ]
    },
    {
      "type": "quote",
      "name": "Quote",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Attribution" }
      ]
    }
  ],
  "presets": [{ "name": "ARVI · Heritage & cellar", "blocks": [{ "type": "stat" }, { "type": "stat" }, { "type": "stat" }, { "type": "quote" }] }]
}
{% endschema %}
