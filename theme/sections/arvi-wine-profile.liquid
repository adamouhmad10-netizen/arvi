{{ 'arvi-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign critics = section.blocks | where: 'type', 'critic'
  assign has_critic = false
  for c in critics
    if c.settings.score != blank or c.settings.review != blank
      assign has_critic = true
    endif
  endfor
  assign producer_handle = 'produttore-' | append: product.vendor | handleize
  assign producer = collections[producer_handle]
-%}

{%- capture wide -%}
      {%- if has_critic -%}
        <section class="arvi-profile__block arvi-critics" aria-labelledby="Critics-{{ section.id }}">
          <h2 class="arvi-eyebrow" id="Critics-{{ section.id }}">{{ section.settings.critics_heading }}</h2>
          <ul class="arvi-critics__list" role="list">
            {%- for block in critics -%}
              {%- if block.settings.score != blank or block.settings.review != blank -%}
                <li class="arvi-critic" {{ block.shopify_attributes }}>
                  <p class="arvi-critic__head">
                    {%- if block.settings.score != blank -%}
                      <span class="arvi-critic__score arvi-display">{{ block.settings.score }}</span>
                    {%- endif -%}
                    <span class="arvi-critic__name arvi-micro">{{ block.settings.source }}</span>
                  </p>
                  {%- if block.settings.review != blank -%}
                    <blockquote class="arvi-critic__review arvi-body">{{ block.settings.review }}</blockquote>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </section>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'producer' -%}
          {%- liquid
            assign story = block.settings.text
            if story == blank and producer != blank
              assign story = producer.description
            endif
          -%}
          {%- if story != blank -%}
            <section class="arvi-profile__block arvi-producer" aria-labelledby="Producer-{{ section.id }}" {{ block.shopify_attributes }}>
              <h2 class="arvi-eyebrow" id="Producer-{{ section.id }}">{{ block.settings.heading }}</h2>
              <p class="arvi-display arvi-display--m">{{ product.vendor }}</p>
              <div class="arvi-body rte">{{ story }}</div>
              {%- if producer != blank -%}
                <a class="arvi-link" href="{{ producer.url }}">{{ 'arvi.product.all_from_producer' | t: producer: product.vendor }}</a>
              {%- endif -%}
            </section>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
{%- endcapture -%}

<div class="arvi-profile color-{{ section.settings.color_scheme }} gradient arvi-pad--{{ section.settings.padding }}">
  <div class="page-width arvi-profile__grid{% if wide == blank %} arvi-profile__grid--single{% endif %}">
    <div class="arvi-profile__col">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vintages' -%}
            <div class="arvi-profile__block" {{ block.shopify_attributes }}>
              {%- render 'arvi-sibling-vintages', product: product, heading: block.settings.heading -%}
            </div>
          {%- when 'facts' -%}
            {%- capture facts -%}{% render 'arvi-wine-facts', product: product, mode: 'list' %}{%- endcapture -%}
            {%- if facts != blank -%}
              <div class="arvi-profile__block" {{ block.shopify_attributes }}>
                <h2 class="arvi-eyebrow">{{ block.settings.heading }}</h2>
                {{ facts }}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if wide != blank -%}
      <div class="arvi-profile__col arvi-profile__col--wide">
        {{- wide -}}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ARVI · Wine profile",
  "tag": "section",
  "class": "section arvi-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "critics_heading", "label": "Critics heading", "default": "Critics' scores" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "select", "id": "padding", "label": "Vertical spacing", "default": "m",
      "options": [{ "value": "s", "label": "Small" }, { "value": "m", "label": "Medium" }, { "value": "l", "label": "Large" }]
    }
  ],
  "blocks": [
    {
      "type": "facts", "name": "Wine facts", "limit": 1,
      "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "The wine" }]
    },
    {
      "type": "vintages", "name": "All vintages", "limit": 1,
      "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "All vintages" }]
    },
    {
      "type": "critic", "name": "Critic score", "limit": 6,
      "settings": [
        { "type": "text", "id": "source", "label": "Critic / publication", "info": "Connect a product metafield with the dynamic-source button." },
        { "type": "text", "id": "score", "label": "Score" },
        { "type": "richtext", "id": "review", "label": "Review" }
      ]
    },
    {
      "type": "producer", "name": "Producer story", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Producer" },
        { "type": "richtext", "id": "text", "label": "Text", "info": "Leave empty to use the description of the producer collection." }
      ]
    }
  ],
  "presets": [{ "name": "ARVI · Wine profile", "blocks": [{ "type": "vintages" }, { "type": "facts" }, { "type": "critic" }, { "type": "producer" }] }]
}
{% endschema %}
