{{ 'arvi-sections.css' | asset_url | stylesheet_tag }}

<div class="arvi-values color-{{ section.settings.color_scheme }} gradient arvi-pad--{{ section.settings.padding }}">
  <div class="page-width">
    {%- render 'arvi-section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      id: section.id
    -%}
    <ul class="arvi-values__list arvi-values__list--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        <li class="arvi-value scroll-trigger animate--slide-in" data-cascade style="--animation-order: {{ forloop.index }};" {{ block.shopify_attributes }}>
          <div class="arvi-value__top">
            <span class="arvi-value__num arvi-meta" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- if block.settings.icon != 'none' -%}
              <span class="arvi-value__icon">{% render 'arvi-icon', icon: block.settings.icon, size: 28 %}</span>
            {%- endif -%}
          </div>
          <h3 class="arvi-display arvi-display--s">{{ block.settings.title }}</h3>
          <div class="arvi-body rte">{{ block.settings.text }}</div>
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a class="arvi-link arvi-link--small" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "ARVI · Why ARVI",
  "tag": "section",
  "class": "section arvi-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why buy from us" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Trust, passion, expertise, respect" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "select", "id": "padding", "label": "Vertical spacing", "default": "l",
      "options": [{ "value": "s", "label": "Small" }, { "value": "m", "label": "Medium" }, { "value": "l", "label": "Large" }]
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "wine",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "wine", "label": "Glass" },
            { "value": "grape", "label": "Grape" },
            { "value": "warehouse", "label": "Cellar" },
            { "value": "truck", "label": "Delivery" },
            { "value": "package", "label": "Case" },
            { "value": "user-round", "label": "Consultant" },
            { "value": "shield-check", "label": "Authenticity" },
            { "value": "award", "label": "Distinction" },
            { "value": "lock", "label": "Vault" },
            { "value": "gift", "label": "Gift" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Outstanding wine selection" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We offer a selection of the finest wines from all over the world.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "ARVI · Why ARVI", "blocks": [{ "type": "value" }, { "type": "value" }, { "type": "value" }, { "type": "value" }] }]
}
{% endschema %}
